// minERP Prisma ORM Schema Definition for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         String           @id @default(uuid())
  name       String
  code       String           @unique
  taxId      String?
  currency   String           @default("USD ($)")
  country    String           @default("US")
  email      String?
  phone      String?
  address    String?
  status     String           @default("Active")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  offices    OfficeLocation[]
  roles      Role[]
  users      User[]
}

model OfficeLocation {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  type      String   @default("Branch Office") // Headquarters | Branch Office | Regional Office | Warehouse
  address   String?
  city      String?
  country   String?
  phone     String?
  email     String?
  manager   String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  users     User[]
}

model Role {
  id           String   @id @default(uuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  permissions  String   // JSON string array of permissions e.g. ["dashboard", "sales", "inventory"]
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  users        User[]
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("Employee") // Role name string fallback
  roleId       String?
  userRole     Role?           @relation(fields: [roleId], references: [id])
  title        String?
  companyId    String?
  company      Company?        @relation(fields: [companyId], references: [id])
  locationId   String?
  location     OfficeLocation? @relation(fields: [locationId], references: [id])
  status       String          @default("Active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Product {
  sku       String   @id
  name      String
  category  String
  stock     Int      @default(0)
  minStock  Int      @default(10)
  unitPrice Float    @default(0.0)
  costPrice Float    @default(0.0)
  barcode   String?  @unique
  imageUrl  String?
  createdAt DateTime @default(now())
}

model SalesOrder {
  id         String           @id
  customer   String
  email      String?
  orderDate  DateTime         @default(now())
  itemsCount Int              @default(1)
  amount     Float
  status     String           @default("Completed")
  createdAt  DateTime         @default(now())
  items      SalesOrderItem[]
}

model SalesOrderItem {
  id      String     @id @default(uuid())
  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku     String
  name    String
  qty     Int
  price   Float
}

model Customer {
  id                 String   @id
  name               String
  company            String?
  email              String   @unique
  phone              String?
  creditLimit        Float    @default(10000.0)
  lifetimeSales      Float    @default(0.0)
  receivablesBalance Float    @default(0.0)
  createdAt          DateTime @default(now())
}

model Employee {
  id         String   @id
  name       String
  role       String
  department String
  salary     Float
  status     String   @default("Active")
  hireDate   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model JournalEntry {
  id            String   @id
  entryDate     DateTime @default(now())
  description   String
  debitAccount  String
  creditAccount String
  amount        Float
  status        String   @default("Posted")
  createdAt     DateTime @default(now())
}

model BankAccount {
  id            String   @id
  name          String
  type          String
  accountNumber String
  balance       Float
  createdAt     DateTime @default(now())
}

model ArInvoice {
  id        String   @id
  customer  String
  date      DateTime
  days      Int
  amount    Float
  createdAt DateTime @default(now())
}

model ApBill {
  id        String   @id
  supplier  String
  billDate  DateTime
  dueDate   DateTime
  amountDue Float
  createdAt DateTime @default(now())
}

model Account {
  code      String   @id
  name      String
  type      String
  category  String
  balance   Float
  createdAt DateTime @default(now())
}

model Deal {
  id          String   @id
  title       String
  company     String
  contact     String
  amount      Float
  stage       String
  probability Int
  createdAt   DateTime @default(now())
}

model Lead {
  id             String   @id
  name           String
  company        String
  email          String
  phone          String
  temperature    String
  source         String
  estimatedValue Float
  createdAt      DateTime @default(now())
}

model Activity {
  id        String   @id
  type      String
  subject   String
  contact   String
  company   String
  date      DateTime
  time      String
  notes     String
  owner     String
  createdAt DateTime @default(now())
}

model Supplier {
  id            String   @id
  name          String
  contactPerson String
  email         String
  phone         String
  category      String
  rating        Float
  paymentTerms  String
  balanceDue    Float
  createdAt     DateTime @default(now())
}

model PurchaseOrder {
  id           String   @id
  supplier     String
  orderDate    DateTime
  deliveryDate DateTime
  itemsCount   Int
  totalAmount  Float
  status       String
  createdAt    DateTime @default(now())
}

model GoodsReceipt {
  id               String   @id
  poId             String
  supplier         String
  receivedDate     DateTime
  unitsReceived    Int
  inspectionStatus String
  inspector        String
  createdAt        DateTime @default(now())
}

model SupplierPayment {
  id              String   @id
  supplier        String
  amount          Float
  method          String
  referenceNumber String
  date            DateTime
  createdAt       DateTime @default(now())
}
